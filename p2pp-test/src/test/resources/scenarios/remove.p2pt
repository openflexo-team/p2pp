=== remove the first member
known-defect: P2PP-D-9
--- source
unit U {
	concept A {
		field x : int;
		field y : int;
		field z : int;
	}
}
--- edit
remove A.x
--- expect
unit U {
	concept A {
		field y : int;
		field z : int;
	}
}

